@startuml medication-domain

title Domain

skinparam classAttributeIconSize 0

package medication {
    class Medication {
        id: UUID
        administrationRoute: AdministrationRoute
        pharmaceuticalForm: PharmaceuticalForm
        medicationIngredients: List<MedicationIngredient>
        medicationClassifications: List<MedicationClassification>
    }

    class AdministrationRoute {
        id: UUID
        code: String
        name: String
        dataProvenances: List<DataProvenance>
    }

    note as AdministrationRouteNote
    Tipos de administração conhecidos:
    - ORAL
    - SUBLINGUAL
    - BUCCAL
    - TOPICAL
    - TRANSDERMAL
    - INHALATION
    - NASAL
    - OPHTHALMIC
    - OTIC
    - RECTAL
    - VAGINAL
    - INTRAVENOUS
    - INTRAMUSCULAR
    - SUBCUTANEOUS
    end note
    AdministrationRoute .. AdministrationRouteNote

    class PharmaceuticalForm {
        id: UUID
        code: String
        name: String
        dataProvenances: List<DataProvenance>
    }

    note as PharmaceuticalFormNote
    Formas farmacêuticas conhecidas:
    - TABLET
    - CAPSULE
    - SOLUTION
    - SUSPENSION
    - SYRUP
    - DROPS
    - CREAM
    - OINTMENT
    - GEL
    - PATCH
    - SPRAY
    - AEROSOL
    - POWDER
    - GRANULE
    - SUPPOSITORY
    - INJECTION
    end note
    PharmaceuticalForm .. PharmaceuticalFormNote

    class ActiveIngredient {
        id: UUID
        inn: String
        dataProvenances: List<DataProvenance>
    }

    class MedicationIngredient {
        strength: Strength
        activeIngredient: ActiveIngredient
    }

    class Strength {
        value: Decimal
        unit: Unit
        perValue: Decimal
        perUnit: Unit
    }

    class MedicinalProduct {
        id: UUID
        name: String
        brandName: String [0..1]
        organizations: List<ProductOrganization>
        medication: Medication
        medicationRegulations: List<MedicationRegulation>
        medicationPackages: List<MedicationPackage>
        dataProvenances: List<DataProvenance>
    }

    class ProductOrganization {
        organization: Organization
        role: ProductOrganizationRole
    }

    enum ProductOrganizationRole {
        LABORATORY
        REGISTRATION_HOLDER
        MANUFACTURER
    }

    class Organization {
        id: UUID
        name: String
        taxIdentificationNumber: String [0..1]
        countryIsoCode: String [0..1]
        dataProvenances: List<DataProvenance>
    }

    class MedicationPackage {
        id: UUID
        quantity: Decimal
        unit: Unit
        gtins: List<String>
        dataProvenances: List<DataProvenance>
    }

    class RegulatoryAuthority {
        id: UUID
        name: String
        acronym: String
        countryIsoCode: String [0..1]
    }

    class MedicationRegulation {
        regulatoryAuthority: RegulatoryAuthority
        classifications: List<RegulatoryClassification>
    }

    class RegulatoryClassification {
        value: String
        type: String
        dataProvenances: List<DataProvenance>
    }

    note as RegulatoryAuthorityNote
    Autoridade regulatória atual:
    - ANVISA
    end note
    RegulatoryAuthority .. RegulatoryAuthorityNote

    note as RegulatoryClassificationNote
    Classificações regulatórias atuais:
    - Tarja vermelha
    - Tarja preta
    - Sem tarja (venda livre)
    end note
    RegulatoryClassification .. RegulatoryClassificationNote

    class MedicationClassification {
        id: UUID
        code: String
        name: String
        medicationClassificationSystem: MedicationClassificationSystem
        parent: MedicationClassification
        dataProvenances: List<DataProvenance>
    }

    class MedicationClassificationSystem {
        id: UUID
        name: String
        acronym: String
        maintainer: SourceOrganization [0..1]
    }

    note as MedicationClassificationSystemNote
    Sistemas de classificação atuais:
    - EphMRA (CMED)
    - ATC (OMS)
    - THERAPEUTIC_CLASS (ANVISA)

    Regra: parent deve pertencer ao mesmo
    MedicationClassificationSystem.
    end note
    MedicationClassificationSystem .. MedicationClassificationSystemNote

    enum Unit {
        MCG
        MG
        G
        KG
        MCL
        ML
        L
        MMOL
        MOL
        MEQ
        IU
        UNIT
        PERCENT
        TABLET
        CAPSULE
        DROP
        DOSE
        PUFF
        SPRAY
        PATCH
        SACHET
        SUPPOSITORY
        AMPOULE
        VIAL
    }
}

package provenance {
    class DataProvenance {
        id: UUID
        etlExecution: ETLExecution [0..1]
        externalReference: String
        extractedAt: DateTime
        role: DataProvenanceRole
    }

    class ETLExecution {
        id: Long
        etlProcess: ETLProcess
        startedAt: DateTime
        finishedAt: DateTime
        status: ETLExecutionStatus
    }

    class ETLProcess {
        id: UUID
        name: String
        version: String
        dataSource: DataSource
    }

    class ETLRawArtifact {
        id: UUID
        etlExecution: ETLExecution
        filePath: String
        checksum: String
        retrievedAt: DateTime
        sizeInBytes: Long
        contentType: String
    }

    enum ETLExecutionStatus {
        SUCCESS
        FAILED
        RUNNING
        CANCELED
    }

    class DataSource {
        id: UUID
        name: String
        type: DataSourceType
        format: DataFormat
        sourceOrganization: SourceOrganization
    }

    class SourceOrganization {
        id: UUID
        name: String
        acronym: String
        countryIsoCode: String [0..1]
    }

    note as SourceOrganizationNote
    Organizações fonte atuais:
    - ANVISA
    - CMED
    - WHO
    - FDA
    end note
    SourceOrganization .. SourceOrganizationNote

    note as DataSourceNote
    Fontes de dados atuais:
    - CSV da CMED
    - CSV da ANVISA
    end note
    DataSource .. DataSourceNote

    enum DataSourceType {
        FILE
        API
        DATABASE
        WEB_RESOURCE
    }

    enum DataFormat {
        CSV
        JSON
        XML
        PDF
        HTML
        OTHER
    }

    enum DataProvenanceRole {
        IDENTIFICATION
        COMPOSITION
        CLASSIFICATION
        REGULATION
        PRESENTATION
        COMMERCIALIZATION
    }
}

MedicinalProduct "1" *-- "0..*" MedicationPackage
MedicinalProduct "1" -- "1" Medication
MedicinalProduct "1" *-- "0..*" ProductOrganization
ProductOrganization "0..*" -- "1" Organization
MedicinalProduct "1" *-- "1..*" MedicationRegulation
MedicinalProduct "1" *-- "0..*" DataProvenance
Medication "0..*" o-- "1" AdministrationRoute
Medication "0..*" o-- "1" PharmaceuticalForm
Medication "1" *-- "1..*" MedicationIngredient
Medication "0..*" o-- "0..*" MedicationClassification
MedicationIngredient "1" *-- "1" Strength
MedicationIngredient "0..*" -- "1" ActiveIngredient
MedicationClassification "0..*" o-- "1" MedicationClassificationSystem
MedicationClassification "0..*" --> "0..1" MedicationClassification : parent
MedicationClassificationSystem "0..*" o-- "0..1" SourceOrganization : maintainer
ActiveIngredient "1" *-- "0..*" DataProvenance
Organization "1" *-- "0..*" DataProvenance
MedicationPackage "1" *-- "0..*" DataProvenance
MedicationClassification "1" *-- "0..*" DataProvenance
AdministrationRoute "1" *-- "0..*" DataProvenance
PharmaceuticalForm "1" *-- "0..*" DataProvenance
RegulatoryClassification "1" *-- "0..*" DataProvenance
DataProvenance "0..*" o-- "0..1" ETLExecution
ETLExecution "0..*" o-- "1" ETLProcess
ETLExecution "1" *-- "0..*" ETLRawArtifact
ETLProcess "0..*" o-- "1" DataSource
DataSource "0..*" o-- "1" SourceOrganization
MedicationRegulation "0..*" -- "1" RegulatoryAuthority
MedicationRegulation "1" *-- "0..*" RegulatoryClassification

@enduml
