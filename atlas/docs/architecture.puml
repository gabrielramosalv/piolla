@startuml atlas-container-c4

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Architecture

Person(consumer, "Consumidor da API", "Aplicação cliente ou usuário que consulta dados de produtos medicinais.")

System_Ext(anvisa, "ANVISA", "CSV / datasets", "Fonte regulatória brasileira consumida pelo Atlas.")
System_Ext(cmed, "CMED", "CSV / datasets", "Fonte brasileira de dados de preços e classificações consumida pelo Atlas.")
System_Ext(openFda, "openFDA", "API REST / datasets", "Fonte de dados dos Estados Unidos consumida pelo Atlas.")
System_Ext(who, "WHO", "Datasets", "Fonte internacional de dados de saúde e medicamentos consumida pelo Atlas.")
System_Ext(otherSources, "Outras fontes de origem", "CSV / API / datasets", "Fontes adicionais suportadas pelo pipeline de dados.")

System_Boundary(atlasSystem, "Atlas") {
    Container(atlasApi, "API Atlas", "API REST", "Expõe o catálogo consolidado: medicamentos, produtos, apresentações, classificações, regulações e proveniência.")
    Container(dataPipeline, "Data Pipeline", "Batch / worker agendado", "Extrai, normaliza, valida, resolve correspondências, persiste dados, registra proveniência e sincroniza o catálogo.")
    ContainerDb(database, "Banco de dados Atlas", "Banco de dados relacional", "Armazena catálogo normalizado, proveniência, referências externas e metadados das execuções de ETL.")
    ContainerDb(rawArtifactStorage, "Raw Artifact Storage", "Filesystem / Object Storage", "Armazena CSVs, JSONs, documentos e outros conteúdos exatamente como foram obtidos para auditoria e reprocessamento.")
    ContainerDb(redis, "Redis", "Armazenamento em memória", "Cache das consultas da API.")
}

Rel(consumer, atlasApi, "Consome", "HTTPS / JSON")

Rel(atlasApi, redis, "Lê e grava resultados de requisições em cache", "Protocolo Redis")
Rel(atlasApi, database, "Lê dados canônicos", "SQL")

Rel(dataPipeline, anvisa, "Obtém dados de", "CSV / dataset")
Rel(dataPipeline, cmed, "Obtém dados de", "CSV / dataset")
Rel(dataPipeline, openFda, "Obtém dados de", "HTTPS / JSON")
Rel(dataPipeline, who, "Obtém dados de", "Importação de dataset")
Rel(dataPipeline, otherSources, "Obtém dados de", "CSV / API / dataset")
Rel(dataPipeline, rawArtifactStorage, "Persiste e recupera artefatos brutos", "Filesystem / Object Storage")
Rel(dataPipeline, database, "Insere ou atualiza catálogo, proveniência e metadados de ETL", "SQL")
Rel(dataPipeline, redis, "Invalida consultas em cache após alterações nos dados", "Protocolo Redis")

SHOW_LEGEND()

@enduml
